# Copy to .env (gitignored), or configure in the DSW RAM-role/secret manager.
ALIYUN_REGION=cn-hangzhou
DLF_REST_URI=https://dlfnext.cn-hangzhou.aliyuncs.com
DLF_WAREHOUSE=vehicle_lake_demo
DLF_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
PAIMON_RAW_TABLE=default.camfront_raw_images
PAIMON_ENRICHED_TABLE=default.camfront_ai_enriched

# Use least-privilege RAM identity; never commit values.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# STS support is SDK/version-dependent: verify in your own deployment.
ALIBABA_CLOUD_SECURITY_TOKEN=

VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=your-vision-model
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=tongyi-embedding-vision-plus
EMBEDDING_VECTOR_DIM=1152

WORK_DIR=/mnt/systemDisk/ad_multimodal
MODEL_ID=Qwen/Qwen2-VL-2B-Instruct
MODEL_CACHE_DIR=/mnt/systemDisk/model_cache
SPLIT_RANDOM_SEED=20260520
VALIDATION_RATIO=0.05
IMAGE_MAX_TOKENS=256
